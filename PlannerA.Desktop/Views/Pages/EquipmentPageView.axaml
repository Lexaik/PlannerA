<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlannerA.Desktop.ViewModels"

             x:Class="PlannerA.Desktop.Views.EquipmentPageView"
             x:DataType="vm:EquipmentPageViewModel">
    
    <DockPanel LastChildFill="True">
        <TextBlock Text="{Binding Title}"
                   DockPanel.Dock="Top"/>
        
        <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Bottom">
            <Button Content="Редактировать"
                    Command="{Binding CommandEditEquipment}"/>
        </StackPanel>
        
        <DataGrid AutoGenerateColumns="False"
                  ItemsSource="{Binding Equipments}"
                  SelectedItem="{Binding SelectedEquipment}"
                  SelectionMode="Single"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование"
                                    Binding="{Binding name}"/>
                <!--<DataGridTemplateColumn>
                    <DataTemplate x:DataType="{x:Type m:Person}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LastName}" />
                            <TextBlock Text="{Binding FirstName}" />
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn>-->
                <DataGridTextColumn Header="id"
                                    Binding="{Binding equipment_id}"/>
                <DataGridTextColumn Header="Наименование"
                                    Binding="{Binding name}"/>
                <DataGridTextColumn Header="Тип"
                                    Binding="{Binding type}"/>
                <DataGridTextColumn Header="Модель"
                                    Binding="{Binding model}"/>
                <DataGridTextColumn Header="Производитель"
                                    Binding="{Binding manufacturer}"/>
                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding description}"/>
                <DataGridTextColumn Header="Стоимость"
                                    Binding="{Binding price}"/>
                <DataGridTextColumn Header="Дата покупки"
                                    Binding="{Binding date_of_purchase}"/>
                <DataGridTextColumn Header="Подразделение"
                                    Binding="{Binding department}"/>
                <DataGridTextColumn Header="Действующий"
                                    Binding="{Binding is_active}"/>
                    <!--<DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0} {1}">
                            <Binding Path="name"/>
                            <Binding Path="date_of_produce"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>-->
                
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
