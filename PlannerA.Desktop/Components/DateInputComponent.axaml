<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             
             x:Class="PlannerA.Desktop.Components.DateInputComponent"
             x:Name="DateComponent">
    <Grid ColumnDefinitions="*, 5*">
        <Label 
               
            Grid.Column="0"/>
        <DatePicker  
            
            Grid.Column="1"/>
    </Grid>
</UserControl>
